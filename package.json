{
  "name": "api-test-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "API 自动化测试平台（M2：Fastify + 内置 SQLite + 执行引擎 + Vue3 前端）",
  "scripts": {
    "start": "node index.js",
    "seed": "node seed.js",
    "seed:oa": "node seed-oa-suite.mjs",
    "test:oa": "node run-oa-suite.mjs",
    "clean:orphans": "node scripts/clean-orphan-runs.mjs",
    "dev": "concurrently -n be,fe -c green,blue \"node index.js\" \"npm --prefix web run dev\"",
    "dev:be": "node --watch index.js",
    "dev:fe": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "test": "vitest run",
    "check:frontend": "node scripts/check-vue-undef.mjs web/src && node scripts/check-vue-tpl.mjs web/src && node scripts/check-vue-refvalue.mjs web/src/views",
    "check:frontend:undef": "node scripts/check-vue-undef.mjs web/src",
    "check:frontend:tpl": "node scripts/check-vue-tpl.mjs web/src",
    "check:frontend:refvalue": "node scripts/check-vue-refvalue.mjs web/src/views",
    "check:docs": "node scripts/check-doc-refs.mjs",
    "check:ui": "node scripts/m11-suite-ui-check.mjs && node scripts/m12-group-ui-check.mjs",
    "check:ui:auto": "node scripts/run-ui-check.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:report": "playwright show-report",
    "verify": "npm run check:frontend && npm run check:docs && npm run build && npm test && npm run test:e2e && npm run check:ui:auto"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.4",
    "vitest": "^4.1.11"
  }
}
